{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://webapi.makeonward.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://webapi.makeonward.com/uploads/:path*"
    },
    {
      "source": "/work/:slug",
      "destination": "/"
    }
  ]
}
